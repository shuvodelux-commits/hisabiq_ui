{
  "version": 1,
  "description": "HisabIQ native single-card Codex builder; frontend-only, human merge",
  "project": {
    "owner": "shuvodelux-commits",
    "title": "HisabIQ Nest Adoption",
    "number": 2
  },
  "worker_backend": "workflow",
  "host": "codex",
  "codex": {
    "model": "gpt-6.1-sol"
  },
  "model_tier": "medium",
  "target": {
    "type": "repo",
    "url": null
  },
  "repo": {
    "path": ".",
    "remote": "https://github.com/shuvodelux-commits/hisabiq_ui"
  },
  "base_branch": "main",
  "timezone": "Asia/Dhaka",
  "columns": [
    "Backlog",
    "Ready",
    "Building",
    "QA",
    "Review",
    "Blocked",
    "Done"
  ],
  "labels": ["qa", "bug", "feature"],
  "paths": {
    "project_md": null,
    "pre_flight_md": null,
    "runs_dir": null
  },
  "human_approves_merge": true,
  "merge_policy": {
    "default": "human",
    "auto_max_lines": 400,
    "allow_auto_on_production": false
  },
  "migrations": {
    "globs": [],
    "allowed_envs": [],
    "target_env": "test",
    "commands": {},
    "checks": {},
    "human_steps": []
  },
  "max_workers": 1,
  "no_progress_cycles": 6,
  "rebuild_cap": 2,
  "truth_gate": "non-trivial",
  "truth_threshold": 70,
  "verify_commands": [
    "npm ci --offline --ignore-scripts --no-audit --no-fund",
    "node_modules/.bin/tsc --noEmit",
    "npm run lint",
    "npm run check:ui-contract",
    "npm test",
    "npm run build"
  ],
  "collect": {
    "sources": ["github"],
    "window_days": 14,
    "custom": []
  },
  "notifications": {
    "channel": "session",
    "bot_identity": "shuvodelux-commits"
  },
  "calibration": {
    "enabled": false
  }
}
