{
  "refine": {
    "dev_command": "npm run dev -- --port $PORT --host 127.0.0.1",
    "ready_path": "/",
    "check_commands": [
      "npx tsc --noEmit",
      "npm run lint",
      "npm run check:ui-contract",
      "CI=1 npm test",
      "npm run build"
    ],
    "env_files": [],
    "states": [
      {
        "name": "main"
      }
    ],
    "rounds": 3,
    "taste_file": "docs/design/taste.md",
    "impeccable": ".agents/skills/impeccable",
    "chatgpt_github": {
      "default_for_connected_chat": true,
      "pr_screenshot_workflow": ".github/workflows/ui-refine-chatgpt.yml",
      "route_marker": "UI-REFINE-ROUTE:",
      "requires_manual_dispatch": false,
      "requires_openai_api_key": false,
      "rounds": 3,
      "artifact_prefix": "ui-refine-chatgpt-shots-pr-"
    }
  }
}
